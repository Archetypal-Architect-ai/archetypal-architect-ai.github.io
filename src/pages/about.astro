---
import BaseLayout from "../layouts/BaseLayout.astro";
import books from "../data/books.json";
---

<BaseLayout title="Behind the worlds — Archetypal Architect"
  ><main>
    <section class="page-header about-header">
      <p class="eyebrow">The person behind the worlds</p><h1>
        I keep wondering<br /><em>what we could become.</em>
      </h1>
    </section><section class="section first-section about-editorial">
      <div class="about-book-stack">
        {
          books.map((b) => (
            <a href={"/books/" + b.id}>
              <img src={b.cover} alt={b.title + " cover"} loading="lazy" />
            </a>
          ))
        }
      </div><article>
        <p class="book-hook">
          I write about systems, monsters, survival, and the people trying to
          make a life inside them.
        </p><p>
          Sometimes that becomes a vampire who refuses to give up her kindness.
          Sometimes it becomes a biological design system and an Earth that
          answers back. The questions keep changing shape: who gets to choose,
          what power costs, and what happens when something we build begins to
          change us.
        </p><p>
          Archetypal Architect is where the novels, songs, psychology, and
          speculation meet. You can start with a book. You can stay for a song.
          You don’t need to understand the whole map to find something that
          matters to you.
        </p><div class="hero-actions">
          <a class="button primary" href="/novels">Meet the books ↗</a><a
            class="text-link"
            href="/contact">Start a conversation →</a
          >
        </div>
      </article>
    </section>
  </main></BaseLayout
>
