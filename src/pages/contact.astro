---
import BaseLayout from "../layouts/BaseLayout.astro";
import { creator } from "../content/projects";
---

<BaseLayout title="Find me elsewhere — Archetypal Architect"
  ><main>
    <section class="page-header">
      <p class="eyebrow">Stay in the conversation</p><h1>
        The work keeps<br /><em>finding new forms.</em>
      </h1><p>
        New music, longer thoughts, the next book. Follow the part that speaks
        to you.
      </p>
    </section><section class="section first-section contact-grid">
      {
        creator.socialLinks.map((link) => (
          <a href={link.url}>
            <>
              <span class="eyebrow">
                {link.label === "Email"
                  ? "Questions · Collaborations · Licensing"
                  : "Follow along"}
              </span>
              <strong>{link.label} ↗</strong>
              <span>{link.url.replace("mailto:", "")}</span>
            </>
          </a>
        ))
      }
    </section>
  </main></BaseLayout
>
