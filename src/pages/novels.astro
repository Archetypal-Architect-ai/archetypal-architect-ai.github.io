---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import ExternalLinks from "../components/ExternalLinks.astro";
import { publicProjects } from "../content/projects";
const books = publicProjects.filter((p) => p.kind === "Novel");
---

<BaseLayout title="Books | Archetypal Architect"
  ><main>
    <PageHeader
      eyebrow="The book shelf"
      title="Find your next obsession."
      description="Begin with The Gentle Shadow: vampires, found family, and kindness that refuses to die."
    /><section class="section first-section reader-books">
      {
        books.map((book) => (
          <article class="reader-book">
            <>
              <a href={"/wiki/" + book.id}>
                <img
                  src={book.thumbnail}
                  alt={book.thumbnailAlt}
                  loading="lazy"
                />
              </a>
              <div>
                <>
                  <p class="eyebrow">
                    {book.series}
                    {book.bookNumber ? " / Book " + book.bookNumber : ""}
                  </p>
                  <h2>{book.title}</h2>
                  <p>{book.summary}</p>
                  <ExternalLinks
                    links={book.links.filter((l) => l.type === "Buy")}
                    variant="button"
                  />
                  <a class="reader-text-link" href={"/wiki/" + book.id}>
                    Explore the book →
                  </a>
                </>
              </div>
            </>
          </article>
        ))
      }
    </section><section class="section reader-bonus">
      <div>
        <h2>A little more Rowan.</h2><p>
          Take the honey-cake recipe home and join the reader list.
        </p><a class="button primary" href="/free">Get the reader bonus</a>
      </div>
    </section>
  </main></BaseLayout
>
