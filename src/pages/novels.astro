---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookShelf from "../components/BookShelf.astro";
---

<BaseLayout title="The books — Archetypal Architect"
  ><main>
    <section class="page-header">
      <p class="eyebrow">Fiction by Archetypal Architect</p><h1>
        Choose your<br /><em>beautiful trouble.</em>
      </h1><p>
        Three books. Kind-hearted vampires, memories that bite, and an Earth
        that refuses to stay a simulation.
      </p>
    </section><section class="section first-section">
      <BookShelf />
    </section><section class="compact-invitation">
      <h2>A little more story,<br /><em>delivered.</em></h2><a
        class="button primary"
        href="/free">Join the reader table ↗</a
      >
    </section>
  </main></BaseLayout
>
