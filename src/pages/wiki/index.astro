---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import WikiMap from "../../components/WikiMap.astro";
import { publicProjects, wikiFacets } from "../../content/projects";
const kinds = [...new Set(publicProjects.map((p) => p.kind))];
---

<BaseLayout title="The rabbit hole — Archetypal Architect"
  ><main>
    <section class="page-header archive-header">
      <p class="eyebrow">The archive / Follow your curiosity</p><h1>
        There is always<br /><em>another door.</em>
      </h1><div class="archive-intro">
        <p>
          Stories become songs. Psychology meets myth. Follow the connections,
          or let chance choose your next stop.
        </p><button class="button outline" data-surprise>Surprise me ↗</button>
      </div>
    </section><section class="section first-section">
      <div class="archive-controls">
        <label
          >Search the archive<input
            type="search"
            placeholder="A title, an idea, a world…"
            data-archive-search
          /></label
        ><label
          >Sort by<select data-archive-sort
            ><option value="featured">Featured first</option><option
              value="alpha">Title A–Z</option
            ><option value="newest">Newest</option></select
          ></label
        >
      </div><div
        class="shelf-filters archive-filters"
        aria-label="Filter the archive"
      >
        <button data-archive-kind="All" aria-pressed="true">Everything</button>{
          kinds.map((kind) => (
            <button data-archive-kind={kind} aria-pressed="false">
              {kind}
            </button>
          ))
        }
      </div><p class="archive-count" role="status" data-archive-count>
        {publicProjects.length} entries to explore
      </p><div class="wiki-entry-list" data-archive-grid>
        {
          publicProjects.map((p) => (
            <div
              data-archive-entry
              data-kind={p.kind}
              data-title={p.title}
              data-date={p.date}
              data-featured={p.featured ? "1" : "0"}
              data-href={"/wiki/" + p.id}
              data-search={[p.title, p.summary, ...p.tags]
                .join(" ")
                .toLowerCase()}
            >
              <ProjectCard project={p} />
            </div>
          ))
        }
      </div><div class="empty-panel" data-archive-empty hidden>
        <h2>No doors here. Yet.</h2><p>
          Try a different search, or return to everything.
        </p><button class="button outline" data-archive-reset
          >Clear filters</button
        >
      </div><div class="archive-callout">
        <p class="eyebrow">A separate shelf</p><h2>
          For adults who<br /><em>know what they’re looking for.</em>
        </h2><p>
          Erotic fiction and mature material have their own entrance.
        </p><a class="text-link" href="/adult-archive">Adult archive · 18+ ↗</a
        >
      </div><details class="map-disclosure">
        <summary>Follow the connections <span>+</span></summary><WikiMap />
      </details>
    </section>
  </main>
  <script is:inline define:vars={{ facets: wikiFacets }}>
    // @ts-nocheck
    const grid = document.querySelector("[data-archive-grid]");
    const cards = [...grid.querySelectorAll("[data-archive-entry]")];
    const search = document.querySelector("[data-archive-search]");
    const sort = document.querySelector("[data-archive-sort]");
    const buttons = [...document.querySelectorAll("[data-archive-kind]")];
    const params = new URLSearchParams(location.search);
    let kind = params.get("category") || "All";
    let facet = facets.find((f) => f.label === params.get("facet"));
    function render() {
      let visible = 0;
      cards
        .sort((a, b) =>
          sort.value === "alpha"
            ? a.dataset.title.localeCompare(b.dataset.title)
            : sort.value === "newest"
              ? (b.dataset.date || "").localeCompare(a.dataset.date || "")
              : Number(b.dataset.featured) - Number(a.dataset.featured),
        )
        .forEach((card) => {
          card.hidden =
            !(kind === "All" || card.dataset.kind === kind) ||
            !!(facet && !facet.kinds.includes(card.dataset.kind)) ||
            !card.dataset.search.includes(search.value.trim().toLowerCase());
          if (!card.hidden) visible++;
          grid.append(card);
        });
      buttons.forEach((b) =>
        b.setAttribute("aria-pressed", String(b.dataset.archiveKind === kind)),
      );
      document.querySelector("[data-archive-count]").textContent =
        visible + " " + (visible === 1 ? "entry" : "entries") + " to explore";
      document.querySelector("[data-archive-empty]").hidden = visible !== 0;
      document.querySelector("[data-surprise]").disabled = visible === 0;
    }
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        kind = b.dataset.archiveKind;
        facet = null;
        render();
      }),
    );
    search.addEventListener("input", render);
    sort.addEventListener("change", render);
    document
      .querySelector("[data-archive-reset]")
      .addEventListener("click", () => {
        kind = "All";
        facet = null;
        search.value = "";
        render();
      });
    document.querySelector("[data-surprise]").addEventListener("click", () => {
      const visible = cards.filter((c) => !c.hidden);
      if (visible.length)
        location.href =
          visible[Math.floor(Math.random() * visible.length)].dataset.href;
    });
    render();
  </script></BaseLayout
>
