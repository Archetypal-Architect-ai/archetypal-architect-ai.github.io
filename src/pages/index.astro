---
import BaseLayout from "../layouts/BaseLayout.astro";
import BookShelf from "../components/BookShelf.astro";
import ListeningRoom from "../components/ListeningRoom.astro";
import allBooks from "../data/books.json";
const books = allBooks.filter((b) => !b.upcoming);
---

<BaseLayout title="Archetypal Architect — Beautifully strange stories"
  ><main>
    <section class="editorial-hero">
      <div class="hero-topline">
        <span>THE WORLDS OF ARCHETYPAL ARCHITECT</span><span
          >Read. Listen. Wander.</span
        >
      </div>
      <div class="hero-composition">
        <div class="hero-statement">
          <p class="eyebrow">
            For the curious. And the beautifully strange.
          </p><h1>Some stories<br />get <em>under<br />your skin.</em></h1><p
            class="hero-description"
          >
            Kind-hearted monsters. Living worlds.<br />Songs that follow you out
            of the room.
          </p><a class="button primary" href="#books"
            >Find your next obsession <span>↗</span></a
          >
        </div>
        <div class="cover-composition">
          <span class="cover-orbit-label">THREE DOORS. NO ORDINARY WORLDS.</span
          >{
            books.map((book, i) => (
              <a
                class={"hero-cover cover-" + i}
                href={"/books/" + book.id}
                aria-label={"Explore " + book.title}
              >
                <img
                  src={book.cover}
                  alt={book.title + " cover"}
                  width="938"
                  height="1500"
                  fetchpriority={i === 0 ? "high" : "auto"}
                />
              </a>
            ))
          }<span class="cover-footnote"
            >Choose a cover.<br /><em>See what’s waiting.</em></span
          >
        </div>
      </div><div class="hero-bottomline">
        <span>FICTION WITH TEETH. IDEAS WITH CONSEQUENCES.</span><a
          href="#books">THE BOOKS ↓</a
        >
      </div>
    </section>
    <section class="section catalog-section" id="books">
      <div class="section-heading editorial-heading">
        <div>
          <p class="eyebrow">01 / The book shelf</p><h2>
            Not quite<br /><em>your usual escape.</em>
          </h2>
        </div><p>
          A soft spot for monsters. A taste for impossible systems. Pick a world
          and make yourself at home.
        </p>
      </div><BookShelf />
    </section>
    <ListeningRoom compact />
    <section class="section curiosity-section">
      <div class="section-heading editorial-heading">
        <div>
          <p class="eyebrow">03 / Down the rabbit hole</p><h2>
            One thing<br /><em>leads to another.</em>
          </h2>
        </div><a class="text-link" href="/wiki">Enter the whole archive ↗</a>
      </div>
      <div class="curiosity-grid">
        <a class="curiosity-feature" href="/wiki/archetypal-mythos"
          ><img
            src="/images/works/memetic-hazard-corridor.png"
            alt="A figure looking into a luminous, uncanny corridor"
            loading="lazy"
          /><div>
            <span class="eyebrow">Myth & imagination</span><h3>
              What happens when<br />an idea starts living?
            </h3><span class="text-link">Explore the mythos ↗</span>
          </div></a
        ><div class="curiosity-links">
          <a href="/wiki/make-anxiety-your-superpower"
            ><span class="eyebrow">Psychology / 01</span><h3>
              Make Anxiety<br />Your Superpower
            </h3><p>
              Attention, agency, and a different relationship with an anxious
              mind.
            </p><span class="arrow-circle">↗</span></a
          ><a href="/wiki/emotional-misinterpretation-dictionary"
            ><span class="eyebrow">Psychology / 02</span><h3>
              When feelings<br />get the translation wrong.
            </h3><p>Open The Emotional Misinterpretation Dictionary.</p><span
              class="arrow-circle">↗</span
            ></a
          >
        </div>
      </div>
    </section>
    <section class="objects-section">
      <a
        class="object-image"
        href="https://www.etsy.com/listing/4584704958/care-is-a-force-tee-mes-publishing"
      >
        <img
          src="/images/shop/care-is-a-force-tee.webp"
          alt="Care Is a Force tee from the Archetypal Architect Etsy shop"
          width="794"
          height="992"
          loading="lazy"
        /><span>CARE IS A FORCE TEE · ON ETSY ↗</span>
      </a><div class="object-copy">
        <p class="eyebrow">04 / Objects from the worlds</p><h2>
          Wear your<br /><em>weird.</em>
        </h2><p>
          A phrase leaves a story. A symbol finds a shirt. A little of the world
          comes home with you.
        </p><p class="edition-note">
          The Etsy shop is open: tees, totes, and mugs, plus the Vault
          Reading Ledger, a printable reading journal for $6.99.
        </p><div class="hero-actions">
          <a
            class="button outline"
            href="https://www.etsy.com/shop/archetypalarchitect"
            >Visit the Etsy shop ↗</a
          ><a class="text-link" href="/merch">See what’s in the shop →</a>
        </div>
      </div>
    </section>
    <section class="letter-section">
      <span class="letter-kicker">AN INVITATION, FROM ROWAN</span><h2>
        Come in.<br />The honey cakes<br /><em>are still warm.</em>
      </h2><p>
        Two of Rowan’s recipes plus Chapter One of The Gentle Shadow, free,
        and a place at the table for whatever comes next.
      </p><div class="hero-actions">
        <a class="button primary" href="/free">Save me a seat ↗</a
        ><a class="text-link" href="/rowans-honey-cakes"
          >Just here for the recipe →</a
        >
      </div><span class="letter-signature">With kindness, and teeth.</span>
    </section>
  </main></BaseLayout
>
