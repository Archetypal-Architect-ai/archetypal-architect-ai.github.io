---
import BaseLayout from "../layouts/BaseLayout.astro";
import shop from "../data/shop.json";
type ShopItem = {
  id: string;
  name: string;
  detail: string;
  price: string;
  blurb: string;
  image: string;
  width: number;
  height: number;
  fit?: string;
  url: string;
};
const groups = shop.groups as {
  id: string;
  title: string;
  intro: string;
  items: ShopItem[];
}[];
const hero = groups
  .flatMap((group) => group.items)
  .find((item) => item.id === "4584684571")!;
---

<BaseLayout
  title="Objects from the worlds — Archetypal Architect"
  description="Tees, totes, mugs, and printables from the worlds of Archetypal Architect, open now on Etsy."
  image="/images/share/merch.jpg"
  ><main>
    <section class="objects-section shop-hero">
      <a class="object-image" href={hero.url}>
        <img
          src={hero.image}
          alt={`${hero.name} tee from the Archetypal Architect Etsy shop`}
          width={hero.width}
          height={hero.height}
        /><span>KINDNESS HAS TEETH TEE · ON ETSY ↗</span>
      </a><div class="object-copy">
        <p class="eyebrow">Objects from the worlds</p><h1>
          Wear your<br /><em>weird.</em>
        </h1><p>
          Words that belong on a shirt. Art that refuses to stay in a book.
          Small pieces of these worlds, made for the one you live in.
        </p><div class="shop-status">
          <span class="eyebrow">The shop is open</span><p>
            Tees, totes, and mugs from the worlds, plus printables for readers.
            Everything is made to order and ships through Etsy.
          </p>
        </div><div class="hero-actions">
          <a class="button primary" href={shop.shopUrl}>Visit the Etsy shop ↗</a
          ><a class="text-link" href="/free">Hear about new pieces first →</a>
        </div>
      </div>
    </section><section class="section shop-shelf">
      <div class="section-heading editorial-heading">
        <div>
          <p class="eyebrow">In the shop now</p><h2>
            Small pieces<br /><em>of the worlds.</em>
          </h2>
        </div><a class="text-link" href={shop.shopUrl}>See everything on Etsy ↗</a>
      </div>
      {
        groups.map((group) => (
          <div class="shop-group" id={group.id}>
            <div class="shop-group-head">
              <h3>{group.title}</h3>
              <p>{group.intro}</p>
            </div>
            <div class="shop-grid">
              {group.items.map((item) => (
                <a class="shop-item" href={item.url}>
                  <img
                    class={item.fit === "contain" ? "is-contain" : undefined}
                    src={item.image}
                    alt={`${item.name}, ${item.detail.toLowerCase()}`}
                    width={item.width}
                    height={item.height}
                    loading="lazy"
                  />
                  <span class="eyebrow">
                    {item.detail} · {item.price}
                  </span>
                  <h4>{item.name}</h4>
                  <p>{item.blurb}</p>
                  <span class="text-link">View on Etsy ↗</span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
      <p class="shop-note">{shop.priceNote}</p>
    </section><section class="compact-invitation">
      <div>
        <p class="eyebrow">Something you can take home today</p><h2>
          Rowan brought<br /><em>honey cakes.</em>
        </h2>
      </div><a class="button primary" href="/free">Get the free recipes ↗</a>
    </section>
  </main></BaseLayout
>
