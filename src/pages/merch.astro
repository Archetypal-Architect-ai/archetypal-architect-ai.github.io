---
import BaseLayout from "../layouts/BaseLayout.astro";
const shop = "https://www.etsy.com/shop/archetypalarchitect";
const ledger =
  "https://www.etsy.com/listing/4586779156/printable-reading-journal-book-tracker";
const products = [
  {
    name: "Kindness Has Teeth tee",
    type: "Apparel · from $27.99",
    blurb: "The Gentle Shadow’s motto in rose, ribbon, and moonlight.",
    image: "/images/shop/kindness-has-teeth-tee.webp",
    url: shop,
  },
  {
    name: "Care Is a Force tee",
    type: "Apparel · from $27.99",
    blurb: "Care is not softness. Gold linework on a soft unisex tee.",
    image: "/images/shop/care-is-a-force-tee.webp",
    url: shop,
  },
  {
    name: "Built from Deep Structures tote",
    type: "Totes",
    blurb: "A canvas tote for books, tools, and everything you build with.",
    image: "/images/shop/deep-structures-tote.webp",
    url: shop,
  },
  {
    name: "Wonder with Machinery Inside It mug",
    type: "Mugs",
    blurb: "For the morning coffee that powers the next draft.",
    image: "/images/shop/wonder-mug.webp",
    url: shop,
  },
  {
    name: "The Vault Reading Ledger",
    type: "Printable · $6.99",
    blurb:
      "A 23-page printable reading journal and book tracker, US Letter and A4.",
    image: "/images/shop/vault-reading-ledger.webp",
    url: ledger,
  },
];
---

<BaseLayout
  title="Objects from the worlds — Archetypal Architect"
  description="Apparel, mugs, totes, and printables from the worlds of Archetypal Architect, open now on Etsy."
  ><main>
    <section class="objects-section shop-hero">
      <div class="object-image">
        <img
          src="/images/works/class-1-memetic-hazard-tee.png"
          alt="Class 1 Memetic Hazard shirt artwork"
        /><span>FROM THE DESIGN ARCHIVE</span>
      </div><div class="object-copy">
        <p class="eyebrow">Objects from the worlds</p><h1>
          Wear your<br /><em>weird.</em>
        </h1><p>
          Words that belong on a shirt. Art that refuses to stay in a book.
          Small pieces of these worlds, made for the one you live in.
        </p><div class="shop-status">
          <span class="eyebrow">The shop is open</span><p>
            Apparel, mugs, and totes from the worlds, plus printables for
            readers. Everything is made to order and ships through Etsy.
          </p>
        </div><div class="hero-actions">
          <a class="button primary" href={shop}>Visit the Etsy shop ↗</a><a
            class="text-link"
            href="/free">Hear about new pieces first →</a
          >
        </div>
      </div>
    </section><section class="section shop-shelf">
      <div class="section-heading editorial-heading">
        <div>
          <p class="eyebrow">In the shop now</p><h2>
            Small pieces<br /><em>of the worlds.</em>
          </h2>
        </div><a class="text-link" href={shop}>See everything on Etsy ↗</a>
      </div><div class="shop-grid">
        {
          products.map((item) => (
            <a class="shop-item" href={item.url}>
              <img
                src={item.image}
                alt={item.name}
                width="800"
                height="800"
                loading="lazy"
              />
              <span class="eyebrow">{item.type}</span>
              <h3>{item.name}</h3>
              <p>{item.blurb}</p>
              <span class="text-link">View on Etsy ↗</span>
            </a>
          ))
        }
      </div>
    </section><section class="compact-invitation">
      <div>
        <p class="eyebrow">Something you can take home today</p><h2>
          Rowan brought<br /><em>honey cakes.</em>
        </h2>
      </div><a class="button primary" href="/free">Get the free recipes ↗</a>
    </section>
  </main></BaseLayout
>
