---
import BaseLayout from "../../layouts/BaseLayout.astro";
import books from "../../data/books.json";
export function getStaticPaths() {
  return books.map((book) => ({ params: { id: book.id }, props: { book } }));
}
const { book } = Astro.props;
// Each world stands on its own: the upcoming series never sits beside the
// earlier system-fiction book in "Keep reading".
const apart = ["fall-from-space", "the-thousandfold-gate"];
const other = books.filter(
  (b) =>
    b.id !== book.id && !(apart.includes(book.id) && apart.includes(b.id)),
);
---

<BaseLayout
  title={book.title + " — Archetypal Architect"}
  description={book.hook}
  image={book.cover}
  ><main>
    <section class="book-detail">
      <div class="book-detail-art">
        <img
          src={book.cover}
          alt={book.title + " cover"}
          width="938"
          height="1500"
        /><a class="text-link" href="/novels">← All books</a>
      </div><article>
        <p class="eyebrow">
          {book.series} / Book {book.number}{book.upcoming && " / Coming soon"}
        </p><h1>
          {book.title}
        </h1><p class="book-tagline">{book.tagline}</p><p class="book-hook">
          {book.hook}
        </p><p>{book.description}</p><ul class="tag-list">
          {book.themes.map((t) => <li>{t}</li>)}
        </ul>{book.note && <p class="edition-note">{book.note}</p>}<div
          class="hero-actions"
        >
          {
            book.amazon ? (
              <a class="button primary" href={book.amazon}>
                Read on Kindle ↗
              </a>
            ) : (
              <a class="button primary" href="/free">
                Hear when it’s out ↗
              </a>
            )
          }{
            book.paperback && (
              <a class="button outline" href={book.paperback}>
                Paperback ↗
              </a>
            )
          }{
            book.otherStores && (
              <a class="button outline" href={book.otherStores}>
                Other ebook stores ↗
              </a>
            )
          }
        </div>{
          book.wiki && (
            <a class="text-link" href={book.wiki}>
              {book.id === "fall-from-space"
                ? "Earlier continuity archive"
                : "Explore the story’s wiki"}{" "}
              →
            </a>
          )
        }
      </article>
    </section><section class="section more-books">
      <p class="eyebrow">Keep reading</p><h2>
        Another door<br /><em>is always open.</em>
      </h2><div>
        {
          other.map((b) => (
            <a href={"/books/" + b.id}>
              <>
                <img
                  src={b.cover}
                  alt={b.title + " cover"}
                  width="938"
                  height="1500"
                  loading="lazy"
                />
                <span>
                  <>
                    <small>{b.genre}</small>
                    <h3>{b.title}</h3>
                    <span>Meet the book ↗</span>
                  </>
                </span>
              </>
            </a>
          ))
        }
      </div>
    </section>
  </main></BaseLayout
>
