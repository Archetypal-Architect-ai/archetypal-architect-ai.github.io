---
import BaseLayout from "../layouts/BaseLayout.astro";
import ListeningRoom from "../components/ListeningRoom.astro";
---

<BaseLayout title="The listening room — Archetypal Architect"
  ><main class="music-page">
    <ListeningRoom /><section class="album-feature" id="more-dice-more-loot">
      <img
        src="/images/music/more-dice-more-loot.webp"
        alt="More Dice, More Loot album cover: dice, a tankard, and a treasure chest on a tavern table"
        width="900"
        height="900"
        loading="lazy"
      /><div>
        <p class="eyebrow">New album · Tavern comedy</p><h2>
          More Dice,<br /><em>More Loot.</em>
        </h2><p>
          Roll initiative. Order a round. Pretend the bard’s in key. A 20-sided
          album: twenty comedy anthems for D&amp;D night, about 70 minutes, with
          a lyrics booklet, a printable initiative tracker, and hi-res cover art.
        </p><div class="hero-actions">
          <a
            class="button primary"
            href="https://whisperingarchitekt.gumroad.com/l/more-dice-more-loot"
            >Get the album · $9.99 ↗</a
          ><a class="text-link" href="https://suno.com/@archetypalarchitect"
            >Listen on Suno ↗</a
          >
        </div>
      </div>
    </section><section class="section music-afterword">
      <p class="eyebrow">Keep the music close</p><h2>
        More songs.<br /><em>Same restless imagination.</em>
      </h2><div class="hero-actions">
        <a class="button primary" href="https://suno.com/@archetypalarchitect"
          >Explore on Suno ↗</a
        ><a
          class="text-link"
          href="https://youtube.com/@archetypal.architect.whispers"
          >Watch on YouTube ↗</a
        ><a class="text-link" href="/wiki/suno-music-catalog"
          >Inside the music archive →</a
        >
      </div>
    </section>
  </main></BaseLayout
>
