---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Watch & listen — Archetypal Architect"
  ><main>
    <section class="page-header">
      <p class="eyebrow">Moving pictures / Restless ideas</p><h1>
        Another way<br /><em>into the story.</em>
      </h1><p>Music, atmosphere, and the work as it takes shape.</p><a
        class="button primary"
        href="https://youtube.com/@archetypal.architect.whispers"
        >Explore the YouTube channel ↗</a
      >
    </section><section class="section first-section">
      <a class="video-feature" href="/wiki/deja-vu"
        ><img
          src="/images/works/deja-vu-thumbnail.jpg"
          alt="Deja Vu music artwork"
          loading="lazy"
        /><div>
          <p class="eyebrow">From the music archive</p><h2>Deja Vu</h2><p>
            Repetition. Recognition. The feeling of having been here before.
          </p><span class="text-link">Inside the song ↗</span>
        </div></a
      >
    </section>
  </main></BaseLayout
>
