---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="A seat at Rowan’s table — Archetypal Architect"
  ><main class="reader-table">
    <section class="reader-table-art">
      <img
        src="/images/books/the-gentle-shadow.jpg"
        alt="The Gentle Shadow official book cover"
        width="938"
        height="1500"
      />
    </section><section class="reader-table-letter">
      <p class="eyebrow">A reader bonus from The Gentle Shadow</p><h1>
        There’s a place<br /><em>for you here.</em>
      </h1><p class="book-hook">
        Honey cakes. Scarves aplenty.<br />And probably someone who needs both.
      </p><p>
        Thank you for reading my story. I have so much more to tell, and I’d
        love to have you beside me for the next journey.
      </p><p>
        Join the reader table and I’ll send you Rowan’s third-batch honey-cake
        recipe. The first batch is ready now.
      </p><a class="button primary" href="https://archetypal-architect.kit.com/"
        >Send me the recipe ↗</a
      ><a class="text-link" href="/rowans-honey-cakes">Read it here instead →</a
      ><p class="letter-signature">With kindness, and teeth.</p>
    </section>
  </main></BaseLayout
>
