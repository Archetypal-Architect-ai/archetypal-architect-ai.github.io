---
import books from "../data/books.json";
const { filters = true } = Astro.props;
---

<div class="book-shelf" data-book-shelf>
  {
    filters && (
      <div class="shelf-toolbar">
        <>
          <div class="shelf-filters" aria-label="Browse books">
            <>
              <button data-book-filter="all" aria-pressed="true">
                All books <span>03</span>
              </button>
              <button data-book-filter="Cozy-goth fantasy" aria-pressed="false">
                Cozy-goth fantasy
              </button>
              <button data-book-filter="Science fiction" aria-pressed="false">
                Science fiction
              </button>
            </>
          </div>
          <span class="small-label" data-book-count>
            3 books
          </span>
        </>
      </div>
    )
  }
  <div class="book-grid">
    {
      books.map((book, i) => (
        <article class="book-card" data-book-genre={book.genre}>
          <a class={"book-art book-art-" + i} href={"/books/" + book.id}>
            <>
              <span class="book-art-number">0{i + 1}</span>
              <img
                src={book.cover}
                alt={book.title + " — official Amazon cover"}
                width="938"
                height="1500"
                loading="lazy"
              />
              <span class="book-art-caption">{book.tagline}</span>
            </>
          </a>
          <div class="book-caption">
            <>
              <p class="eyebrow">
                {book.series} · Book {book.number}
              </p>
              <h3>
                <a href={"/books/" + book.id}>{book.title}</a>
              </h3>
              <p>{book.hook}</p>
              <div class="book-actions">
                <>
                  <button class="text-link" data-open-book={book.id}>
                    Peek inside <span aria-hidden="true">↗</span>
                  </button>
                  <a href={book.amazon} class="text-link quiet">
                    Get the book ↗
                  </a>
                </>
              </div>
            </>
          </div>
        </article>
      ))
    }
  </div>
  {
    books.map((book) => (
      <dialog
        class="book-dialog"
        id={"peek-" + book.id}
        aria-labelledby={"peek-title-" + book.id}
      >
        <>
          <button
            class="dialog-close"
            data-close-book
            aria-label="Close book preview"
          >
            ×
          </button>
          <div class="book-dialog-grid">
            <>
              <img
                src={book.cover}
                alt={book.title + " cover"}
                width="938"
                height="1500"
              />
              <div>
                <p>{book.description}</p>
                {book.note && <p class="edition-note">{book.note}</p>}
                <div class="hero-actions">
                  <>
                    <a class="button primary" href={book.amazon}>
                      Read on Kindle ↗
                    </a>
                    <a class="text-link" href={"/books/" + book.id}>
                      More about the book →
                    </a>
                  </>
                </div>
              </div>
            </>
          </div>
        </>
      </dialog>
    ))
  }
</div>
<script>
  document
    .querySelectorAll<HTMLElement>("[data-book-shelf]")
    .forEach((shelf) => {
      shelf
        .querySelectorAll<HTMLButtonElement>("[data-book-filter]")
        .forEach((button) =>
          button.addEventListener("click", () => {
            shelf
              .querySelectorAll("[data-book-filter]")
              .forEach((item) =>
                item.setAttribute("aria-pressed", String(item === button)),
              );
            let count = 0;
            shelf
              .querySelectorAll<HTMLElement>("[data-book-genre]")
              .forEach((card) => {
                card.hidden =
                  button.dataset.bookFilter !== "all" &&
                  card.dataset.bookGenre !== button.dataset.bookFilter;
                if (!card.hidden) count++;
              });
            const label = shelf.querySelector("[data-book-count]");
            if (label)
              label.textContent =
                count + " " + (count === 1 ? "book" : "books");
          }),
        );
      shelf
        .querySelectorAll<HTMLButtonElement>("[data-open-book]")
        .forEach((button) =>
          button.addEventListener("click", () => {
            const dialog = document.getElementById(
              "peek-" + button.dataset.openBook,
            ) as HTMLDialogElement;
            dialog.showModal();
          }),
        );
      shelf.querySelectorAll<HTMLDialogElement>("dialog").forEach((dialog) => {
        dialog
          .querySelector("[data-close-book]")
          ?.addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", (e) => {
          if (e.target === dialog) {
            const r = dialog.getBoundingClientRect();
            if (
              e.clientX < r.left ||
              e.clientX > r.right ||
              e.clientY < r.top ||
              e.clientY > r.bottom
            )
              dialog.close();
          }
        });
      });
    });
</script>
