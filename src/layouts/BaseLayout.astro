---
import "../styles/global.css";
import { creator } from "../content/projects";

const {
  title = `${creator.name} | Creative Archive`,
  description = creator.tagline,
  image = "/images/hero-studio.png",
} = Astro.props;

const nav = [
  ["Books", "/novels"],
  ["Music", "/music"],
  ["Explore", "/wiki"],
  ["Shop", "/merch"],
  ["About", "/about"],
  ["Reader bonus", "/free"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <span>{creator.name}</span>
        <small>Books · Music · Curious worlds</small>
      </a>
      <nav class="main-nav" aria-label="Primary navigation">
        {nav.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <strong>{creator.name}</strong>
      <nav aria-label="More from Archetypal Architect">
        <a href="/contact">Contact & follow</a><a href="/essays">Essays</a><a
          href="/videos">Videos</a
        ><a href="/wiki/backmatter-link-index">Reader links</a><a
          href="/adult-archive">Adult archive · 18+</a>
      </nav>
    </footer>
  </body>
</html>
